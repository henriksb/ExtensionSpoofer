<Window x:Class="MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="ExtensionSpoofer"
        Height="440"
        Width="680"
        MinHeight="440"
        MinWidth="680"
        WindowStartupLocation="CenterScreen"
        Loaded="OnMainWindowLoaded">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="16,8" />
            <Setter Property="Margin" Value="6,0" />
            <Setter Property="MinWidth" Value="120" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style TargetType="Label">
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </Window.Resources>
    <Grid Background="#FFF4F6F8" Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="ExtensionSpoofer"
                       FontSize="28"
                       FontWeight="SemiBold"
                       Foreground="#FF1E293B" />
            <TextBlock Text="Spoof file display names and icons for educational demonstrations."
                       Margin="0,4,0,0"
                       Foreground="#FF475569" />
        </StackPanel>

        <Border Grid.Row="1"
                Background="White"
                BorderBrush="#FFE2E8F0"
                BorderThickness="1"
                CornerRadius="8"
                Padding="14"
                Margin="0,0,0,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="140" />
                    <ColumnDefinition Width="140" />
                </Grid.ColumnDefinitions>

                <Label Grid.Row="0" Grid.Column="0" Content="File name" />
                <Label Grid.Row="0" Grid.Column="1" Content="Source extension" HorizontalContentAlignment="Center" />
                <Label Grid.Row="0" Grid.Column="2" Content="Spoof extension" HorizontalContentAlignment="Center" />

                <TextBox x:Name="NameInput"
                         Grid.Row="1"
                         Grid.Column="0"
                         Margin="0,4,8,0"
                         Height="28" />
                <ComboBox x:Name="SourceExtension"
                          Grid.Row="1"
                          Grid.Column="1"
                          Margin="0,4,8,0"
                          Height="28"
                          IsReadOnly="True" />
                <ComboBox x:Name="SpoofExtension"
                          Grid.Row="1"
                          Grid.Column="2"
                          Margin="0,4,0,0"
                          Height="28"
                          IsReadOnly="True" />

                <TextBox x:Name="CurrentFile"
                         Grid.Row="2"
                         Grid.Column="0"
                         Grid.ColumnSpan="3"
                         Margin="0,10,0,0"
                         Height="24"
                         IsReadOnly="True"
                         BorderThickness="0"
                         Background="#FFF8FAFC"
                         TextAlignment="Center"
                         Text="Current file: None"
                         VerticalContentAlignment="Center" />
            </Grid>
        </Border>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Margin="0,0,0,10">
            <Button x:Name="OpenFile" Content="Select executable" />
            <Button x:Name="GenerateButton" Content="Generate spoofed file" />
        </StackPanel>

        <Border Grid.Row="3"
                Background="White"
                BorderBrush="#FFE2E8F0"
                BorderThickness="1"
                CornerRadius="8"
                Padding="12"
                Margin="0,0,0,10">
            <StackPanel HorizontalAlignment="Center">
                <TextBlock Text="Preview"
                           FontWeight="SemiBold"
                           FontSize="14"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,6" />
                <Image x:Name="IconImage"
                       Width="100"
                       Height="100"
                       Source="img/blankfile.ico" />
                <TextBox x:Name="OutputName"
                         Margin="0,10,0,0"
                         MinWidth="560"
                         IsReadOnly="True"
                         BorderThickness="0"
                         Background="Transparent"
                         HorizontalContentAlignment="Center"
                         Text="[OUTPUT NAME]" />
            </StackPanel>
        </Border>

        <TextBlock x:Name="StatusText"
                   Grid.Row="4"
                   Text="Ready"
                   HorizontalAlignment="Center"
                   FontWeight="SemiBold"
                   Margin="0,0,0,2" />
    </Grid>
</Window>
